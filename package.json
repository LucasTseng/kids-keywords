{
  "name": "kids-keywords",
  "version": "1.0.7",
  "description": "kids-keywords · Interactive English vocabulary typing & dictation app for young learners (Shanghai primary grades 1–3), powered by the vkeyboardhand touch-typing component. 面向小朋友的英语词汇 · 短句打字与背默学习应用，基于 vkeyboardhand 指法组件。",
  "keywords": [
    "keyboard",
    "svg",
    "touch-typing",
    "typing",
    "finger",
    "fingering",
    "teaching",
    "virtual-keyboard",
    "vkeyboard",
    "vue",
    "react",
    "angular"
  ],
  "license": "MIT",
  "author": "LucasTseng",
  "homepage": "https://github.com/LucasTseng/kids-keywords#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasTseng/kids-keywords.git"
  },
  "bugs": {
    "url": "https://github.com/LucasTseng/kids-keywords/issues"
  },
  "main": "dist/vkeyboardhand.umd.js",
  "module": "dist/vkeyboardhand.esm.mjs",
  "unpkg": "dist/vkeyboardhand.umd.js",
  "jsdelivr": "dist/vkeyboardhand.umd.js",
  "style": "dist/vkeyboardhand.css",
  "files": [
    "dist",
    "src",
    "svg/keyboard.svg",
    "svg/hand.svg",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/vkeyboardhand.esm.mjs",
      "require": "./dist/vkeyboardhand.umd.js",
      "default": "./dist/vkeyboardhand.umd.js"
    },
    "./dist/vkeyboardhand.css": "./dist/vkeyboardhand.css",
    "./vkeyboardhand.css": "./dist/vkeyboardhand.css",
    "./svg/keyboard.svg": "./svg/keyboard.svg",
    "./svg/hand.svg": "./svg/hand.svg",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "prepublishOnly": "npm run build && npm test",
    "build": "node scripts/build.mjs && node scripts/build-vocabulary.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "npx serve . -l 8011",
    "test": "node --test scripts/*.test.mjs",
    "app": "electron electron/main.cjs",
    "app:dir": "electron-builder --dir",
    "app:win": "electron-builder --win",
    "app:mac": "electron-builder --mac"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "build": {
    "appId": "com.lucastseng.kids-keywords",
    "productName": "Kids Keywords",
    "copyright": "MIT © LucasTseng",
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "practice.html",
      "history.html",
      "help.html",
      "data.html",
      "app/**/*",
      "dist/**/*",
      "vendor/**/*",
      "data/**/*",
      "svg/**/*",
      "icons/**/*",
      "manifest.webmanifest",
      "sw.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "打字背默练习",
      "artifactName": "${productName}-安装包-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-便携版-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.5",
    "sql.js": "^1.14.2",
    "xlsx": "0.18.5"
  }
}
